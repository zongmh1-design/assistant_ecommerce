# Safe example only. Copy to .env and replace local values before startup.
APP_NAME=ecommerce-operations-assistant
APP_ENV=development
DEBUG=false

# PostgreSQL connection used by the application and Alembic.
DATABASE_URL=postgresql+psycopg://ecommerce_app:replace-with-local-password@localhost:5432/ecommerce_assistant

# Generate a private random value of at least 32 characters for your local .env.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI calls remain disabled. Never commit a real key.
AI_PROVIDER=mock
AI_MODEL=mock
AI_API_KEY=

# External platform integrations remain mocked in the first version.
EXTERNAL_INTEGRATION_MODE=mock
