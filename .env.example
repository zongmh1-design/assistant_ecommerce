# Safe example only. Copy to .env and replace local values before startup.
APP_NAME=ecommerce-operations-assistant
APP_ENV=development
DEBUG=false

# PostgreSQL connection used by the application and Alembic.
# These values are local-development placeholders only. Change them outside source control.
POSTGRES_DB=ecommerce_assistant
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=local-dev-password-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ecommerce_app:local-dev-password-change-me@localhost:5432/ecommerce_assistant

# Generate a private random value of at least 32 characters for your local .env.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Use mock by default. Set openai_compatible explicitly for a real legal endpoint.
LLM_PROVIDER=mock
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=
LLM_MODEL=your-model
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Running generation jobs older than this are marked timeout by the admin sweep.
GENERATION_JOB_TIMEOUT_SECONDS=300

# External platform integrations remain mocked in the first version.
EXTERNAL_INTEGRATION_MODE=mock
